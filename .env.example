# Runtime
TZ=UTC

# Database
MYSQL_VERSION=10.6.22
MYSQL_DATABASE=whaticket
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-secret
DB_USER=whaticket
DB_PASSWORD=replace-with-a-long-database-secret

# Public URLs
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
PROXY_PORT=443

# Authentication: use independent random values in every environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret

# WhatsApp provider: wwebjs or whaileys
WHATSAPP_PROVIDER=wwebjs
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Redis session/key persistence
REDIS_VERSION=7.4.2-alpine
REDIS_DB=0
