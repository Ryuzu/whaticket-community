# WhatsApp provider: wwebjs (QR/Puppeteer) or whaileys (QR/WebSocket)
WHATSAPP_PROVIDER=wwebjs

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error
WA_SOCKET_VERSION=
WHATSAPP_BROWSER_NAME=Chrome

# Chrome/Puppeteer (wwebjs)
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
DB_NAME=whaticket
DB_USER=whaticket
DB_PASS=

# JWT secrets (required and unique in production)
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too

# URLs and CORS
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PROXY_PORT=3000

# Redis: whaileys key material and optional socket/session cache
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=0
